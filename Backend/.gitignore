# Ignore Python compiled files
*.pyc
*.pyo
*.pyd
__pycache__/

# Ignore environment variables and sensitive data
.env
*.env

# Ignore Django migrations (optional, only if tracking them manually)
**/migrations/**

# Ignore database files (if using SQLite)
db.sqlite3
*.db

# Ignore logs and temp files
*.log
*.pid
*.swp

# Ignore virtual environment
venv/
env/

# Ignore IDE/editor files
.vscode/
.idea/
*.iml

# Ignore node_modules (if any frontend exists inside backend)
node_modules/

# Ignore static and media files (if storing locally)
staticfiles/
media/

# Ignore Django secret key files (if any)
secret_key.json
